{
  "name": "comics",
  "type": "module",
  "version": "0.4.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "quick-build": "astro build",
    "preview": "astro preview",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:write": "prettier --write . ",
    "format:check": "prettier --check . ",
    "lint-staged": "lint-staged",
    "astro": "astro",
    "update-dependencies": "bunx @astrojs/upgrade;bun update",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{md,html,json}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.astro": [
      "oxlint --fix",
      "prettier --plugin=prettier-plugin-astro --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.4.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.18.8",
    "astro": "5.7.4",
    "globals": "^15.15.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bun": "^1.2.23",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxlint": "^0.16.12",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
